---
import AppLayout from "../../layouts/AppLayout.astro";
import SubmissionForm from "../../features/submissions/SubmissionForm";
---

<AppLayout title="Input Branding">
  <div class="mx-auto max-w-6xl">
    <div>
      <h2 class="text-2xl font-bold text-[#0B1D3A]">Input Branding</h2>
      <p class="mt-1 text-sm text-slate-500">
        Lengkapi data toko, lokasi GPS, status branding, dan dokumentasi foto.
      </p>
    </div>

    <div class="mt-6">
      <SubmissionForm client:load />
    </div>
  </div>
</AppLayout>
