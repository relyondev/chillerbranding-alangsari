---
import AppLayout from "../../layouts/AppLayout.astro";

---
<AppLayout title="Akun"><div class="mx-auto max-w-3xl"><h2 class="text-2xl font-bold text-[#0B1D3A]">Pengaturan Akun</h2><p class="mt-1 text-sm text-slate-500">Informasi akun dan keamanan.</p><div class="brand-card mt-6 rounded-2xl p-6"><h3 class="font-semibold text-[#0B1D3A]">Profil</h3><div class="mt-5 grid gap-5 sm:grid-cols-2"><div><label class="text-sm font-medium text-slate-600">Nama</label><input disabled value="User Demo" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"/></div><div><label class="text-sm font-medium text-slate-600">Email</label><input disabled value="user@example.com" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"/></div></div></div><div class="brand-card mt-6 rounded-2xl p-6"><h3 class="font-semibold text-[#0B1D3A]">Keamanan</h3><div class="mt-5 flex flex-wrap gap-3"><button class="rounded-xl bg-[#1565EF] px-4 py-2.5 text-sm font-semibold text-white">Ubah Password</button><button class="rounded-xl border border-[#BEE6FF] px-4 py-2.5 text-sm font-semibold text-[#0B1D3A]">Ubah Email</button></div></div></div></AppLayout>
