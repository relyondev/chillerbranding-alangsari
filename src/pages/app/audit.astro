---
import AppLayout from "../../layouts/AppLayout.astro";
---
<AppLayout title="Audit Log">
  <section class="brand-card rounded-2xl p-6">
    <h2 class="text-2xl font-bold text-[#0B1D3A]">Audit Log</h2>
    <p class="mt-2 text-sm text-slate-500">Riwayat aksi penting: submit, reopen, user, assignment, upload, delete, dan sinkronisasi.</p>
    <div class="mt-6 rounded-xl border border-dashed border-[#BEE6FF] bg-[#F5F9FF] p-10 text-center text-sm text-slate-400">Data audit akan tampil setelah Auth aktif dan event mulai tercatat.</div>
  </section>
</AppLayout>
