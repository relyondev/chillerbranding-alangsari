---
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "../styles/global.css";
import LoginForm from "../features/auth/LoginForm";
import ThemeToggle from "../components/ui/ThemeToggle";
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#d71920" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("branding-ops-theme");
        const theme = saved || "light";
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>Login | Branding Chiller</title>
      <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="min-h-screen bg-[#f6f6f6]">
    <main class="relative min-h-screen px-4 py-5 sm:px-6 lg:px-8">
      <div class="absolute right-4 top-4 z-30 sm:right-6 sm:top-6"><ThemeToggle client:load compact /></div>
      <section class="mx-auto grid min-h-[calc(100vh-40px)] max-w-[1220px] overflow-hidden rounded-[30px] border border-black/10 bg-white shadow-[0_24px_70px_rgba(0,0,0,.14)] lg:grid-cols-[1.08fr_.92fr]">
        <div class="relative overflow-hidden bg-[#0b0b0b] px-7 py-9 text-white sm:px-10 lg:px-12 lg:py-12">
          <div class="absolute -left-24 -top-24 h-72 w-72 rounded-full bg-[#d71920]/30 blur-2xl"></div>
          <div class="absolute -bottom-28 -right-20 h-80 w-80 rounded-full bg-[#d71920]/25 blur-3xl"></div>
          <div class="relative z-10 flex h-full flex-col justify-between gap-12">
            <div>
              <img src="/hm-hanzi-logo.png" alt="HM Hanzi Management" class="h-auto w-full max-w-[270px] rounded-xl object-contain" />
              <p class="mt-10 text-sm font-semibold uppercase tracking-[0.18em] text-[#ff696e]">Branding Chiller</p>
              <h1 class="mt-4 max-w-[580px] text-[38px] font-bold leading-[1.05] tracking-[-0.04em] sm:text-[52px]">
                Operasional branding yang lebih rapi, cepat, dan terukur.
              </h1>
              <p class="mt-6 max-w-[560px] text-[15px] leading-7 text-white/70 sm:text-[17px]">
                Kelola input branding, dokumentasi lapangan, progres pekerjaan, dan laporan dalam satu sistem terpusat.
              </p>
            </div>
            <div class="flex items-center gap-3 text-sm text-white/75">
              <span class="h-2.5 w-2.5 rounded-full bg-[#d71920] shadow-[0_0_0_6px_rgba(215,25,32,.16)]"></span>
              Akses aman sesuai peran pengguna
            </div>
          </div>
        </div>
        <div class="flex items-center px-6 py-9 sm:px-10 lg:px-14">
          <div class="mx-auto w-full max-w-[450px]">
            <p class="text-sm font-semibold uppercase tracking-[0.12em] text-[#d71920]">Branding Chiller</p>
            <h2 class="mt-3 text-[34px] font-bold tracking-[-0.035em] text-[#111827] sm:text-[42px]">Masuk ke sistem</h2>
            <p class="mt-4 text-[15px] leading-7 text-slate-500">Gunakan akun yang telah didaftarkan oleh administrator untuk mengakses fitur sesuai peran.</p>
            <LoginForm client:load />
            <p class="mt-6 text-center text-xs text-slate-400">Akses terbatas untuk pengguna terdaftar.</p>
          </div>
        </div>
      </section>
      <footer class="px-2 pb-2 pt-5 text-center text-xs text-slate-400">
      Development by <span class="font-semibold text-[#111827]">Hanz Management</span> in collaboration with <span class="font-semibold text-[#111827]">Relyon</span>.
    </footer>
    </main>
  </body>
</html>
