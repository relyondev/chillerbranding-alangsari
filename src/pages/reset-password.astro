---
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/600.css";
import "../styles/global.css";
import ResetPasswordForm from "../features/auth/ResetPasswordForm";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Reset Password | Branding Chiller</title>
      <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <main class="flex min-h-screen items-center justify-center px-4 py-10">
      <div class="brand-shadow w-full max-w-md rounded-3xl border border-[var(--role-border)] bg-white p-8">
        <h1 class="text-2xl font-bold text-[#0B1D3A]">Buat password baru</h1>
        <p class="mt-2 text-sm leading-6 text-slate-500">Masukkan password baru untuk akun Anda.</p>
        <ResetPasswordForm client:load />
      </div>
    </main>
  </body>
</html>
