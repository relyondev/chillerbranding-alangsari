---
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/600.css";
import "../styles/global.css";
import ForgotPasswordForm from "../features/auth/ForgotPasswordForm";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Lupa Password | Branding Ops App</title>
  </head>
  <body>
    <main class="flex min-h-screen items-center justify-center px-4 py-10">
      <div class="brand-shadow w-full max-w-md rounded-3xl border border-[#BEE6FF] bg-white p-8">
        <a href="/login" class="text-sm font-semibold text-[#1565EF]">← Kembali ke login</a>
        <h1 class="mt-6 text-2xl font-bold text-[#0B1D3A]">Lupa password</h1>
        <p class="mt-2 text-sm leading-6 text-slate-500">Masukkan email akun untuk menerima link reset password.</p>
        <ForgotPasswordForm client:load />
      </div>
    </main>
  </body>
</html>
