---
const pathname = Astro.url.pathname;

const menu = [
  { label: "Dashboard", href: "/app/dashboard", icon: "▦", roles: ["super_admin","admin","pic","client"] },
  { label: "Input Branding", href: "/app/submissions", icon: "＋", roles: ["pic"] },
  { label: "Pekerjaan", href: "/app/reporting", icon: "▤", roles: ["super_admin","admin"] },
  { label: "Pekerjaan Saya", href: "/app/reporting", icon: "▤", roles: ["pic"] },
  { label: "Laporan", href: "/app/reporting", icon: "▤", roles: ["client"] },
  { label: "Manajemen User", href: "/app/users", icon: "♙", roles: ["super_admin","admin"] },
  { label: "Master Data", href: "/app/master-data", icon: "◆", roles: ["super_admin","admin"] },
  { label: "Akun", href: "/app/account", icon: "⚙", roles: ["super_admin","admin","pic","client"] },
];
---

<aside class="fixed inset-y-0 left-0 z-40 hidden w-72 border-r border-white/10 bg-[#0B1D3A] lg:flex lg:flex-col">
  <div class="flex h-20 items-center border-b border-white/10 px-7">
    <div>
      <p class="text-lg font-bold tracking-tight text-white">Branding Ops</p>
      <p class="text-xs font-medium text-[#BEE6FF]">Operational System</p>
    </div>
  </div>

  <div class="px-4 pt-4">
    <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-3">
      <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#4DB6FF]">Role</p>
      <p id="desktop-role-label" class="mt-1 text-sm font-semibold text-white">Super Admin</p>
    </div>
  </div>

  <nav class="flex-1 space-y-1 p-4">
    {menu.map((item) => {
      const active = pathname === item.href || pathname.startsWith(`${item.href}/`);
      return (
        <a
          href={item.href}
          data-role-nav
          data-roles={item.roles.join(",")}
          class:list={[
            "flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition",
            active
              ? "bg-[#1565EF] text-white shadow-[0_10px_30px_rgba(21,101,239,.28)]"
              : "text-slate-300 hover:bg-white/10 hover:text-white",
          ]}
        >
          <span class="flex h-7 w-7 items-center justify-center text-base">{item.icon}</span>
          <span>{item.label}</span>
        </a>
      );
    })}
  </nav>

  <div class="border-t border-white/10 p-4">
    <div class="rounded-xl border border-white/10 bg-white/5 p-4">
      <p class="text-xs font-semibold uppercase tracking-wide text-[#4DB6FF]">Project</p>
      <p class="mt-1 text-sm font-semibold text-white">Branding Ops App</p>
      <p class="mt-1 text-xs text-slate-400">Clean-slate system</p>
    </div>
  </div>
</aside>
