---
interface Props{label:string;value:string;description:string;accent?:"navy"|"blue"|"sky"|"yellow"}const{label,value,description,accent="blue"}=Astro.props;const m={navy:"bg-[#0B1D3A]",blue:"bg-[var(--role-accent)]",sky:"bg-[var(--role-soft)]",yellow:"bg-[#FFC107]"}[accent];
---
<article class="brand-card rounded-2xl p-5"><div class:list={["mb-4 h-1.5 w-12 rounded-full",m]}></div><p class="text-sm font-medium text-slate-500">{label}</p><p class="mt-3 text-3xl font-bold text-[#0B1D3A]">{value}</p><p class="mt-2 text-xs text-slate-400">{description}</p></article>
